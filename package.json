{
  "name": "@doguyilmaz/tapster",
  "version": "0.0.0",
  "description": "Sign, notarize and publish the releases of all your projects from one Homebrew tap, set up in your browser",
  "keywords": [
    "homebrew",
    "homebrew-tap",
    "release",
    "code-signing",
    "notarization",
    "github-actions",
    "goreleaser",
    "bun",
    "sparkle",
    "scoop",
    "apt",
    "dnf",
    "mcp"
  ],
  "homepage": "https://tapster.doguyilmaz.com",
  "bugs": {
    "url": "https://github.com/doguyilmaz/tapster/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doguyilmaz/tapster.git"
  },
  "license": "MIT",
  "author": "Dogu Yilmaz",
  "type": "module",
  "bin": {
    "tapster": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p src/web/client",
    "build:action": "bun build ./src/action/main.ts --target=node --format=esm --minify --outfile dist/index.js",
    "build:cli": "bun scripts/build.ts cli"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@preact/signals": "2.11.3",
    "@types/bun": "1.4.3",
    "preact": "10.29.8",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
