{
  "compilerOptions": {
    "lib": ["ESNext"], "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "types": ["bun-types"], "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "resolveJsonModule": true
  },
  "include": ["src", "tests", "scripts"],
  "exclude": ["src/web/client"]
}
